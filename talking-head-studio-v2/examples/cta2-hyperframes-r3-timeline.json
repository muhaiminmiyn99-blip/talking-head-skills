  {
   "id": "S1",
   "start": 0,
   "end": 1.5,
   "text": "Selalu tengok Fira dekat phone je kan?"
  },
  {
   "id": "S2",
   "start": 1.94,
   "end": 2.74,
   "text": "Tak nak tengok depan-depan?"
  },
  {
   "id": "S3",
   "start": 3.44,
   "end": 5.6,
   "text": "Dalam channel, you nampak setup yang Fira share tu."
  },
  {
   "id": "S4",
   "start": 5.92,
   "end": 7.82,
   "text": "Tapi macam mana Fira cari confirmation"
  },
  {
   "id": "S5",
   "start": 7.82,
   "end": 9.74,
   "text": "before Fira bagi setup tu?"
  },
  {
   "id": "S6",
   "start": 10.02,
   "end": 11.6,
   "text": "Yang ni, Fira nak you all tengok sendiri."
  },
  {
   "id": "S7",
   "start": 11.8,
   "end": 14.18,
   "text": "Daripada macam mana Fira open Fira Smart Desk,"
  },
  {
   "id": "S8",
   "start": 14.42,
   "end": 16.9,
   "text": "sampailah Fira chart zone dekat chart"
  },
  {
   "id": "S9",
   "start": 16.9,
   "end": 18.72,
   "text": "and then macam mana Fira tunggu confirmation"
  },
  {
   "id": "S10",
   "start": 18.72,
   "end": 20.68,
   "text": "before Fira consider untuk entry."
  },
  {
   "id": "S11",
   "start": 21.04,
   "end": 22.86,
   "text": "Kali ni, you duduk sama-sama dengan Fira,"
  },
  {
   "id": "S12",
   "start": 23.08,
   "end": 24.3,
   "text": "kita tengok chart sekali."
  },
  {
   "id": "S13",
   "start": 24.3,
   "end": 27.1,
   "text": "So, kalau you all nak tahu kenapa Fira pilih zone tu"
  },
  {
   "id": "S14",
   "start": 27.1,
   "end": 29.14,
   "text": "ataupun kenapa Fira tunggu dekat zone tu,"
  },
  {
   "id": "S15",
   "start": 29.4,
   "end": 31.45,
   "text": "you all boleh terus tanya direct."
  },
  {
   "id": "S16",
   "start": 31.49,
   "end": 33,
   "text": "And then barulah you nampak macam mana proses"
  },
  {
   "id": "S17",
   "start": 33,
   "end": 34.45,
   "text": "sebelum Fira bagi setup dalam channel tu."
  },
  {
   "id": "S18",
   "start": 34.48,
   "end": 36.45,
   "text": "Nak duduk trade sekali dengan Fira?"
  },
  {
   "id": "S19",
   "start": 36.48,
   "end": 38.56,
   "text": "Click link atas tu and join channel Fira."
  },
  {
   "id": "S20",
   "start": 38.82,
   "end": 40.1,
   "text": "Stand by for next event."
  },
  {
   "id": "S21",
   "start": 40.47,
